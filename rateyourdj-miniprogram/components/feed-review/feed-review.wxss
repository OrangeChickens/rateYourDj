.feed-card {background:#FFF;border:2rpx solid #000;padding:32rpx;margin-bottom:32rpx;color:#000;}
.feed-reason {font-size:22rpx;color:#666;margin-bottom:16rpx;}.feed-dj {display:flex;align-items:center;gap:16rpx;}.feed-dj image {width:80rpx;height:80rpx;flex-shrink:0;}.feed-dj > view {flex:1;min-width:0;}.feed-dj-name {display:block;font-size:30rpx;font-weight:700;overflow-wrap:break-word;}.feed-score {font-size:32rpx;font-weight:700;flex-shrink:0;}.feed-muted {display:block;color:#666;font-size:24rpx;line-height:1.8;}
.feed-author {display:flex;align-items:center;gap:16rpx;margin:24rpx 0;font-size:22rpx;color:#666;}.feed-author image {width:48rpx;height:48rpx;flex-shrink:0;}.feed-stars {display:block;font-size:28rpx;letter-spacing:2rpx;}.feed-comment {display:block;margin:16rpx 0;font-size:28rpx;line-height:1.8;overflow-wrap:break-word;white-space:pre-wrap;}.feed-tags {display:flex;gap:16rpx;flex-wrap:wrap;}.feed-tags text {font-size:22rpx;border:2rpx solid #CCC;padding:8rpx 16rpx;}
.feed-card button:not([size='mini']) {box-sizing:border-box;border:2rpx solid #000;border-radius:0;width:100%;margin:16rpx 0;padding:16rpx;background:#FFF;color:#000;font-size:24rpx;line-height:1.5;font-weight:600;}.feed-card button::after {border:0;}.feed-actions {display:flex;gap:16rpx;margin-top:32rpx;}.feed-card .feed-actions button:not([size='mini']) {flex:1;min-width:0;width:0;min-height:88rpx;display:flex;align-items:center;justify-content:center;border:0;padding:16rpx 0;margin:0;font-size:22rpx;}.feed-card .feed-actions button.voted:not([size='mini']) {background:#000;color:#FFF;}.feed-discussion {border-top:2rpx solid #E0E0E0;margin-top:16rpx;padding-top:16rpx;}.feed-feedback {display:block;padding:16rpx;border:2rpx solid #000;font-size:24rpx;line-height:1.8;}
