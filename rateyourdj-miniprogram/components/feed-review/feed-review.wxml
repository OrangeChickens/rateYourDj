<view wx:if="{{item}}" class="feed-card">
  <view class="feed-reason">{{item.recommendation_reason}}</view>
  <view class="feed-dj" bindtap="viewDJ"><image src="{{item.dj_photo_url || '/images/default-avatar.png'}}" mode="aspectFill" /><view><text class="feed-dj-name">{{item.dj_name}}</text><text class="feed-muted">{{item.dj_city}}</text></view><text class="feed-score">{{item.overall_rating}}/5</text></view>
  <view class="feed-author"><image src="{{item.is_anonymous ? '/images/anonymous-avatar.png' : (item.avatar_url || '/images/default-avatar.png')}}" mode="aspectFill"/><text>{{item.is_anonymous ? '匿名用户' : item.nickname}} · {{item.dateLabel}}</text></view>
  <view bindtap="viewDetail"><text class="feed-stars">{{item.stars}}</text><text class="feed-comment" selectable="{{true}}">{{item.comment || '这位用户留下了一条评分'}}</text><view class="feed-tags"><text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view></view>
  <view class="feed-actions"><button data-type="helpful" bindtap="vote" disabled="{{voting}}" class="{{item.user_vote === 'helpful' ? 'voted' : ''}}">▲ {{item.helpful_count}}</button><button data-type="not_helpful" bindtap="vote" disabled="{{voting}}" class="{{item.user_vote === 'not_helpful' ? 'voted' : ''}}">▼ {{item.not_helpful_count}}</button><button bindtap="toggleComments">评论 {{item.comment_count}}</button><button open-type="share" bindtap="prepareShare" data-review-id="{{item.id}}">分享 ↗</button></view>
  <view wx:if="{{expanded}}" class="feed-discussion"><button class="write-comment" bindtap="writeComment" disabled="{{sending}}">{{sending ? '发送中…' : '写评论'}}</button><text wx:if="{{feedback}}" class="feed-feedback">{{feedback}}</text><text wx:if="{{commentsLoading}}" class="feed-muted">加载评论中…</text><view wx:if="{{commentsError}}"><text>{{commentsError}}</text><button bindtap="retryComments">重试</button></view><text wx:elif="{{!commentsLoading && comments.length === 0}}" class="feed-muted">暂无公开评论</text><comment-list comments="{{comments}}" reviewId="{{item.id}}" bind:upvote="upvote" bind:downvote="downvote" bind:reply="reply" bind:toggleReply="reply" bind:delete="deleteComment" /><button wx:if="{{commentsMore && !commentsError}}" bindtap="moreComments" disabled="{{commentsLoading}}">更多评论</button></view>
</view>
