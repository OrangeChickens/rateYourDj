<view class="page"><text class="heading">{{name}}</text><text class="muted">扫码查看DJ主页与评价</text><text wx:if="{{env === 'trial'}}" class="muted">体验版专用码，仅体验成员可用；正式版会使用独立的正式码。</text><text wx:if="{{loading}}" class="muted">正在生成…</text><view wx:if="{{error}}"><text>{{error}}</text><button bindtap="loadCode">重试</button></view><image wx:if="{{image}}" class="code" src="{{image}}" mode="widthFix" bindtap="preview" /><button wx:if="{{image}}" class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存DJ分享码</button></view>
