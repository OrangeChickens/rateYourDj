.page { padding: 48rpx; color: #000; background: #FFF; min-height: 100vh; box-sizing: border-box; }
.heading { display: block; font-size: 36rpx; font-weight: 700; margin-bottom: 32rpx; overflow-wrap: break-word; }
.label { display: block; font-size: 26rpx; font-weight: 700; margin: 32rpx 0 16rpx; }
input, textarea, .picker { box-sizing: border-box; width: 100%; padding: 24rpx; border: 2rpx solid #000; border-radius: 0; font-size: 26rpx; background: #FFF; }
input { height: 88rpx; } textarea { height: 192rpx; }
.row { display: flex; gap: 16rpx; } .row picker { flex: 1; }
.muted { display: block; font-size: 24rpx; color: #666; line-height: 1.8; margin-top: 16rpx; overflow-wrap: break-word; }
button { margin: 32rpx 0 0; padding: 24rpx; border: 2rpx solid #000; border-radius: 0; background: #FFF; color: #000; font-size: 26rpx; font-weight: 700; line-height: 1.5; }
button::after { border: none; } button[disabled] { color: #666; background: #E0E0E0; }
.primary, .selected { background: #000; color: #FFF; } .selected .muted { color: #CCC; }
.card { padding: 32rpx; border: 2rpx solid #000; margin-top: 16rpx; font-size: 26rpx; }
.history { margin-top: 64rpx; padding-top: 32rpx; border-top: 2rpx solid #000; }
.player { display: block; width: 100%; height: 368rpx; margin-top: 32rpx; }

.lineup-row { display:flex; justify-content:space-between; align-items:center; gap:16rpx; margin-bottom:16rpx; } .lineup-row button { margin:0; padding:16rpx; font-size:24rpx; }

/* Override style:v2's fixed 184px native-button width within content forms. */
.page button:not([size='mini']) { display:block; box-sizing:border-box; width:100%; max-width:100%; min-width:0; margin-left:0; margin-right:0; }
.page .row button:not([size='mini']) { flex:1; width:0; }
.page .lineup-row button:not([size='mini']), .page .lineup-result button:not([size='mini']) { flex:0 0 auto; width:auto; max-width:160rpx; margin:0; padding:16rpx; }
.venue-result { padding:32rpx; border:2rpx solid #000; background:#F5F5F5; margin-top:16rpx; }
.venue-result-label { display:block; font-size:24rpx; font-weight:700; }
.venue-result-name { display:block; margin-top:16rpx; font-size:32rpx; font-weight:700; overflow-wrap:break-word; }
.venue-result-next { display:block; margin-top:16rpx; font-size:26rpx; font-weight:700; }
.search-field { display:flex; align-items:stretch; width:100%; box-sizing:border-box; border:2rpx solid #000; }
.search-field input { flex:1; min-width:0; width:0; border:0; padding:16rpx; height:96rpx; }
.page .search-field button:not([size='mini']) { flex:0 0 176rpx; width:176rpx; max-width:176rpx; margin:0; padding:16rpx; border:0; border-left:2rpx solid #000; background:#000; color:#FFF; font-size:24rpx; line-height:1.5; display:flex; align-items:center; justify-content:center; }
.page .search-field button[disabled]:not([size='mini']) { background:#E0E0E0; color:#666; }
.search-feedback { min-height:48rpx; }
.lineup-result { display:flex; justify-content:space-between; align-items:center; gap:16rpx; padding:24rpx 0; border-bottom:2rpx solid #E0E0E0; }
.lineup-result > view { flex:1; min-width:0; }
.result-name { display:block; font-size:28rpx; font-weight:700; overflow-wrap:break-word; }
