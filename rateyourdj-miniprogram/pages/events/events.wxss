.page {padding:48rpx;background:#FFF;min-height:100vh;box-sizing:border-box;color:#000;}
.eyebrow {display:block;font-size:24rpx;font-weight:700;letter-spacing:1rpx;}
.heading {display:block;font-size:48rpx;font-weight:700;margin:16rpx 0 32rpx;}
.controls {display:flex;gap:16rpx;align-items:center;margin:16rpx 0;}.controls picker,.controls button {flex:1;min-width:0;}
button,.control {box-sizing:border-box;border:2rpx solid #000;border-radius:0;background:#FFF;color:#000;padding:16rpx;font-size:26rpx;font-weight:700;line-height:1.5;margin:0;text-align:center;}button::after {border:0;}
.day-scroll {margin:32rpx 0;white-space:nowrap;}.days {display:flex;gap:16rpx;}.day {flex:none;display:flex;flex-direction:column;gap:16rpx;border:2rpx solid #000;padding:16rpx;text-align:center;font-size:24rpx;}
.active {background:#000;color:#FFF;}.muted {display:block;color:#666;font-size:24rpx;line-height:1.8;overflow-wrap:break-word;}.empty {display:block;padding:48rpx 0;font-size:28rpx;line-height:1.8;}
.event {padding:32rpx 0;border-bottom:2rpx solid #000;}.event-time {font-size:24rpx;font-weight:700;}.event-title {display:block;font-size:32rpx;font-weight:700;line-height:1.5;overflow-wrap:break-word;}.lineup {display:block;font-size:26rpx;margin:16rpx 0;overflow-wrap:break-word;}
.event-map {width:100%;height:640rpx;margin:32rpx 0;}.venue-panel {position:fixed;bottom:0;left:0;right:0;background:#FFF;border-top:2rpx solid #000;padding:32rpx 48rpx calc(32rpx + env(safe-area-inset-bottom));max-height:60vh;overflow:auto;z-index:100;}
