<!-- 首页 -->
<view class="container">
  <!-- 搜索框 -->
  <view class="search-section">
    <view class="search-bar" bindtap="goToSearch">
      <text class="search-icon">SEARCH</text>
      <text class="search-placeholder">{{searchPlaceholder}}</text>
    </view>
  </view>

  <!-- Slogan -->
  <view class="slogan-section">
    <text class="tagline">一个DJ评分社区</text>
    <text class="tagline-sub">好DJ值得被看见，烂DJ也是</text>
  </view>

  <!-- 统计数据看板 -->
  <stats-dashboard
    wx:if="{{dashboardStats}}"
    stats="{{dashboardStats}}"
    texts="{{statsTexts}}" />

  <!-- 最近评价 -->
  <recent-reviews
    wx:if="{{recentReviews && recentReviews.length > 0}}"
    reviews="{{recentReviews}}"
    texts="{{recentReviewsTexts}}"
    reviewCount24h="{{reviewCount24h}}"
    bind:viewall="handleViewAllReviews" />

  <view class="events-entry" bindtap="goToEvents"><text>演出日历</text><text class="events-entry-note">按城市、日期找演出 · 地图查看场地 →</text></view>

  <view class="home-feed-tabs"><view class="home-feed-tab {{activeFeed === 'for-you' ? 'selected' : ''}}" data-tab="for-you" bindtap="changeFeed">For You</view><view class="home-feed-tab {{activeFeed === 'following' ? 'selected' : ''}}" data-tab="following" bindtap="changeFeed">关注的 DJ</view><view class="home-feed-tab {{activeFeed === 'hot' ? 'selected' : ''}}" data-tab="hot" bindtap="changeFeed">热门 DJ</view></view>
  <view wx:if="{{activeFeed !== 'hot'}}" class="home-review-feed">
    <text class="feed-description">{{activeFeed === 'following' ? '你收藏的 DJ 就是这里的关注 · 按评价发布时间排序' : '结合关注、相近风格、新鲜度和有帮助投票推荐 · 不改变 DJ 评分'}}</text>
    <feed-review wx:for="{{feedReviews}}" wx:key="id" review="{{item}}" bind:share="prepareFeedShare" bind:update="updateFeedReview" />
    <text wx:if="{{feedLoading}}" class="feed-state">加载评价中…</text>
    <view wx:if="{{feedError}}" class="feed-state"><text>{{feedError}}</text><button bindtap="retryFeed">重试</button></view>
    <view wx:elif="{{!feedLoading && feedReviews.length === 0}}" class="feed-state"><block wx:if="{{activeFeed === 'following' && !feedLoggedIn}}"><text>登录后查看你关注 DJ 的评价</text><button bindtap="loginForFeed">去登录</button></block><block wx:elif="{{activeFeed === 'following' && followingCount === 0}}"><text>还没有关注 DJ，点击 DJ 主页的星标即可关注</text><button bindtap="exploreDJs">发现 DJ</button></block><text wx:else>{{activeFeed === 'following' ? '你关注的 DJ 暂时还没有公开评价' : '暂无公开评价'}}</text></view>
    <text wx:if="{{!feedLoading && !feedMore && feedReviews.length > 0 && !feedError}}" class="feed-state">已看完这批评价，下拉可刷新</text>
  </view>
  <block wx:if="{{activeFeed === 'hot'}}">
  <!-- 城市选择 -->
  <view class="city-section" bindtap="goToCityList">
    <text class="city-icon">CITY</text>
    <text class="city-name">{{selectedCity}}</text>
    <text class="city-arrow">▼</text>
  </view>

  <!-- 风格筛选 -->
  <view class="genre-filter" wx:if="{{genreGroups.length > 0}}">
    <scroll-view scroll-x="{{true}}" class="genre-scroll">
      <view class="genre-list">
        <text
          class="genre-item {{selectedGenre === '' ? 'active' : ''}}"
          bindtap="selectGenre"
          data-genre="">
          ALL
        </text>
        <text
          wx:for="{{genreGroups}}"
          wx:key="genre_group"
          class="genre-item {{selectedGenre === item.genre_group ? 'active' : ''}}"
          bindtap="selectGenre"
          data-genre="{{item.genre_group}}">
          {{item.genre_group}}
        </text>
      </view>
    </scroll-view>
  </view>

  <!-- 子类/标签筛选 -->
  <view class="subgroup-filter" wx:if="{{subGroups.length > 1}}">
    <scroll-view scroll-x="{{true}}" class="genre-scroll">
      <!-- 状态1：显示子类列表 -->
      <view class="genre-list" wx:if="{{!selectedSubGroup}}">
        <text
          class="subgroup-item {{selectedSubGroup === '' ? 'active' : ''}}"
          bindtap="selectSubGroup"
          data-subgroup="">
          ALL
        </text>
        <text
          wx:for="{{subGroups}}"
          wx:key="sub_group"
          class="subgroup-item"
          bindtap="selectSubGroup"
          data-subgroup="{{item.sub_group}}">
          {{item.sub_group}}
        </text>
      </view>
      <!-- 状态2：已选子类 → 显示 ← + 子类名 + 具体标签 -->
      <view class="genre-list" wx:else>
        <text class="subgroup-item back-btn" bindtap="goBackToSubGroups">←</text>
        <text class="subgroup-item active">{{selectedSubGroup}}</text>
        <text
          wx:for="{{subGroupTags}}"
          wx:key="*this"
          class="subgroup-item tag-item {{selectedTag === item ? 'active' : ''}}"
          bindtap="selectTag"
          data-tag="{{item}}">
          {{item}}
        </text>
      </view>
    </scroll-view>
  </view>

  <!-- A-Z 筛选 -->
  <view class="letter-filter">
    <scroll-view scroll-x="{{true}}" class="letter-scroll">
      <view class="letter-list">
        <text
          class="letter-item {{selectedLetter === '' ? 'active' : ''}}"
          bindtap="selectLetter"
          data-letter="">
          ALL
        </text>
        <text
          wx:for="{{letters}}"
          wx:key="*this"
          class="letter-item {{selectedLetter === item ? 'active' : ''}}"
          bindtap="selectLetter"
          data-letter="{{item}}">
          {{item}}
        </text>
      </view>
    </scroll-view>
  </view>

  <!-- 热门DJ -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">{{hotDJsTitle}}</text>
    </view>

    <view class="dj-list" wx:if="{{hotDJs.length > 0}}">
      <view
        class="dj-card"
        wx:for="{{hotDJs}}"
        wx:key="id"
        bindtap="goToDJDetail"
        data-id="{{item.id}}"
      >
        <!-- DJ卡片 -->
        <view class="dj-card-header">
          <view class="image-wrapper skeleton">
            <image
              class="dj-avatar"
              src="{{item.photo_url || '/images/default-avatar.png'}}"
              mode="aspectFill"
              lazy-load="{{true}}"
            />
          </view>
          <view class="dj-info">
            <text class="dj-name">{{item.name}}</text>
            <view class="dj-meta">
              <text class="dj-city">{{item.city}}</text>
              <text class="dj-label" wx:if="{{item.label}}" catchtap="goToLabel" data-label="{{item.label}}">{{item.label}} →</text>
            </view>
          </view>
        </view>

        <view class="dj-card-body">
          <!-- 评分 -->
          <view class="rating-section">
            <view class="overall-rating">
              <text class="rating-number rating-{{item.overall_rating >= 4 ? 'high' : item.overall_rating >= 3 ? 'medium' : 'low'}}">{{item.overall_rating}}</text>
              <view class="rating-stars">
                <text class="star star-filled" wx:for="{{item.fullStars}}" wx:key="index">★</text>
                <text class="star star-empty" wx:for="{{item.emptyStars}}" wx:key="index">★</text>
              </view>
            </view>
            <view class="rating-info">
              <text class="review-count">{{item.review_count}}条评论</text>
              <text class="would-choose" wx:if="{{item.would_choose_again_percent !== null}}">
                <text class="would-choose-percent">{{item.would_choose_again_percent}}%</text>
                <text class="would-choose-label">会再次捧场</text>
              </text>
            </view>
          </view>

          <!-- 标签 -->
          <view class="tags" wx:if="{{item.music_style}}">
            <text class="tag" wx:for="{{item.styleList}}" wx:key="index">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 初始加载中 -->
    <view class="loading" wx:if="{{loading && currentPage === 1}}">
      <text>{{loadingText}}</text>
    </view>

    <view wx:if="{{hotError}}" class="feed-state"><text>{{hotError}}</text><button bindtap="retryHot">重试</button></view>
    <!-- 空状态 -->
    <view class="empty-state" wx:elif="{{!loading && hotDJs.length === 0}}">
      <text class="empty-icon">—</text>
      <text class="empty-text">{{noDataText}}</text>
    </view>

    <!-- 底部加载状态 -->
    <view class="load-more" wx:if="{{hotDJs.length > 0}}">
      <text wx:if="{{loading}}" class="loading-text">{{loadingText}}</text>
    </view>
  </view>
  </block>
  <canvas canvas-id="review-share-canvas" class="review-share-canvas" />
</view>
