/* Keep the shared review identical to the DJ page's review card. */
@import "../dj-detail/dj-detail.wxss";

.container { box-sizing: border-box; padding-bottom: 64rpx; }
.dj-info { padding-right: 0; height: auto; min-height: 200rpx; gap: 32rpx; }
.dj-name { font-size: 48rpx; }
.reviews-section { margin-top: 0; padding: 0 48rpx; }
.review-header .user-info { min-width: 0; }
.review-header .nickname { overflow-wrap: break-word; }
.review-header .rating { flex-shrink: 0; white-space: nowrap; }
.rating-row { line-height: 1.8; }
.review-content .comment { white-space: pre-wrap; overflow-wrap: break-word; }
.detail-actions { display: flex; align-items: stretch; gap: 16rpx; padding-top: 32rpx; border-top: 2rpx solid #E0E0E0; }
.detail-button { box-sizing: border-box; width: 100%; margin: 0; padding: 24rpx 32rpx; border: 2rpx solid #000; border-radius: 0; background: #FFF; color: #000; font-size: 26rpx; font-weight: 700; line-height: 1.5; text-align: center; }
.detail-button::after { border: none; }
.detail-actions .detail-button { display: flex; align-items: center; justify-content: center; width: auto; min-width: 0; padding: 24rpx 16rpx; }
.share-button { flex: 1; background: #000; color: #FFF; }
.view-dj-button { flex: 2; }
.state { padding: 96rpx 48rpx; text-align: center; font-size: 26rpx; font-weight: 600; }
.state .detail-button { margin-top: 32rpx; }
.review-share-canvas { position: fixed; left: -1000px; top: 0; width: 500px; height: 400px; pointer-events: none; }
